{
  "notes": "Built-in console commands of the 360 CoD games, written for this tool. Best effort: not every entry exists in every title update. Flags: H = affects everyone in a match you host (use private matches), C = needs 'sv_cheats 1' in a match you host.",
  "groups": {"all": ["cod4", "waw", "mw2", "bo1", "mw3", "bo2", "ghosts", "aw"], "modern": ["mw2", "bo1", "mw3", "bo2", "ghosts", "aw"], "old": ["cod4", "waw", "mw2", "bo1", "mw3"]},
  "commands": [
    {"name": "cg_fov", "cat": "view", "flags": "", "games": "all", "desc": "Field of view.", "default": "65", "example": "cg_fov 90"},
    {"name": "cg_fovScale", "cat": "view", "flags": "", "games": "modern", "desc": "Multiplier applied on top of cg_fov.", "default": "1", "example": "cg_fovScale 1.2"},
    {"name": "cg_thirdPerson", "cat": "view", "flags": "C", "games": "all", "desc": "Third-person camera.", "default": "0", "example": "cg_thirdPerson 1"},
    {"name": "cg_thirdPersonRange", "cat": "view", "flags": "", "games": "all", "desc": "Third-person camera distance.", "default": "120", "example": "cg_thirdPersonRange 150"},
    {"name": "cg_thirdPersonAngle", "cat": "view", "flags": "", "games": "all", "desc": "Third-person camera angle around the player.", "default": "0", "example": "cg_thirdPersonAngle 180"},
    {"name": "cg_drawGun", "cat": "view", "flags": "", "games": "all", "desc": "Show your weapon model.", "default": "1", "example": "cg_drawGun 0"},
    {"name": "cg_gun_x", "cat": "view", "flags": "", "games": "all", "desc": "Weapon model offset forward/back.", "default": "0", "example": "cg_gun_x 3"},
    {"name": "cg_gun_y", "cat": "view", "flags": "", "games": "all", "desc": "Weapon model offset left/right.", "default": "0", "example": "cg_gun_y -2"},
    {"name": "cg_gun_z", "cat": "view", "flags": "", "games": "all", "desc": "Weapon model offset up/down.", "default": "0", "example": "cg_gun_z 1"},
    {"name": "r_fog", "cat": "view", "flags": "C", "games": "all", "desc": "World fog.", "default": "1", "example": "r_fog 0"},
    {"name": "r_fullbright", "cat": "view", "flags": "C", "games": "old", "desc": "Draw everything without lighting.", "default": "0", "example": "r_fullbright 1"},
    {"name": "r_filmTweakEnable", "cat": "view", "flags": "", "games": "old", "desc": "Enable colour tweaks (needed for the r_filmTweak* settings).", "default": "0", "example": "r_filmTweakEnable 1"},
    {"name": "r_filmUseTweaks", "cat": "view", "flags": "", "games": "old", "desc": "Apply the r_filmTweak* settings.", "default": "0", "example": "r_filmUseTweaks 1"},
    {"name": "r_filmTweakContrast", "cat": "view", "flags": "", "games": "old", "desc": "Contrast when film tweaks are on.", "default": "1.4", "example": "r_filmTweakContrast 1.4"},
    {"name": "r_filmTweakBrightness", "cat": "view", "flags": "", "games": "old", "desc": "Brightness when film tweaks are on.", "default": "0", "example": "r_filmTweakBrightness 0.1"},
    {"name": "r_filmTweakDesaturation", "cat": "view", "flags": "", "games": "old", "desc": "Desaturation when film tweaks are on (1 = black and white).", "default": "0.2", "example": "r_filmTweakDesaturation 1"},
    {"name": "r_filmTweakInvert", "cat": "view", "flags": "", "games": "old", "desc": "Invert colours when film tweaks are on.", "default": "0", "example": "r_filmTweakInvert 1"},
    {"name": "cg_draw2D", "cat": "hud", "flags": "", "games": "all", "desc": "Draw the HUD at all (0 = clean screen for clips).", "default": "1", "example": "cg_draw2D 0"},
    {"name": "cg_drawCrosshair", "cat": "hud", "flags": "", "games": "all", "desc": "Draw the crosshair.", "default": "1", "example": "cg_drawCrosshair 0"},
    {"name": "cg_drawFPS", "cat": "hud", "flags": "", "games": "all", "desc": "Frame-rate counter.", "default": "0", "example": "cg_drawFPS 1"},
    {"name": "cg_scoreboardPingText", "cat": "hud", "flags": "", "games": "old", "desc": "Show ping as numbers on the scoreboard.", "default": "0", "example": "cg_scoreboardPingText 1"},
    {"name": "cg_chatHeight", "cat": "hud", "flags": "", "games": "all", "desc": "Number of chat lines shown.", "default": "8", "example": "cg_chatHeight 0"},
    {"name": "cg_laserForceOn", "cat": "hud", "flags": "C", "games": "modern", "desc": "Force a laser sight on your weapon.", "default": "0", "example": "cg_laserForceOn 1"},
    {"name": "cg_brass", "cat": "hud", "flags": "", "games": "all", "desc": "Ejected shell casings.", "default": "1", "example": "cg_brass 0"},
    {"name": "cg_blood", "cat": "hud", "flags": "", "games": "all", "desc": "Blood effects.", "default": "1", "example": "cg_blood 0"},
    {"name": "developer", "cat": "hud", "flags": "", "games": "all", "desc": "Developer messages on screen.", "default": "0", "example": "developer 1"},
    {"name": "sv_cheats", "cat": "player", "flags": "H", "games": "all", "desc": "Allow cheat-protected commands in a match you host.", "default": "0", "example": "sv_cheats 1"},
    {"name": "god", "cat": "player", "flags": "HC", "games": "all", "desc": "Toggle god mode for yourself.", "example": "god"},
    {"name": "demigod", "cat": "player", "flags": "HC", "games": "all", "desc": "Toggle demigod (you take damage but don't die).", "example": "demigod"},
    {"name": "noclip", "cat": "player", "flags": "HC", "games": "all", "desc": "Toggle flying through walls.", "example": "noclip"},
    {"name": "ufo", "cat": "player", "flags": "HC", "games": "all", "desc": "Toggle flying with collision off (like noclip).", "example": "ufo"},
    {"name": "notarget", "cat": "player", "flags": "HC", "games": "all", "desc": "Toggle AI/bots ignoring you.", "example": "notarget"},
    {"name": "give", "cat": "player", "flags": "HC", "games": "all", "desc": "Give yourself an item, e.g. 'give ammo' or a weapon name.", "example": "give ammo"},
    {"name": "take", "cat": "player", "flags": "HC", "games": "all", "desc": "Take an item from yourself.", "example": "take all"},
    {"name": "kill", "cat": "player", "flags": "H", "games": "all", "desc": "Kill yourself (respawn).", "example": "kill"},
    {"name": "player_sustainAmmo", "cat": "player", "flags": "HC", "games": "all", "desc": "Ammo doesn't go down.", "default": "0", "example": "player_sustainAmmo 1"},
    {"name": "player_sprintUnlimited", "cat": "player", "flags": "HC", "games": "modern", "desc": "Sprint forever.", "default": "0", "example": "player_sprintUnlimited 1"},
    {"name": "player_meleeRange", "cat": "player", "flags": "HC", "games": "all", "desc": "Melee reach.", "default": "64", "example": "player_meleeRange 200"},
    {"name": "perk_weapSpreadMultiplier", "cat": "player", "flags": "HC", "games": ["cod4", "mw2", "bo1", "mw3", "bo2", "ghosts"], "desc": "Hip-fire spread multiplier for the Steady Aim perk.", "default": "0.65", "example": "perk_weapSpreadMultiplier 0.3"},
    {"name": "jump_height", "cat": "world", "flags": "HC", "games": "all", "desc": "Jump height.", "default": "39", "example": "jump_height 999"},
    {"name": "g_speed", "cat": "world", "flags": "H", "games": "all", "desc": "Movement speed.", "default": "190", "example": "g_speed 400"},
    {"name": "g_gravity", "cat": "world", "flags": "H", "games": "all", "desc": "Gravity.", "default": "800", "example": "g_gravity 100"},
    {"name": "g_knockback", "cat": "world", "flags": "H", "games": "all", "desc": "Knockback when hit.", "default": "1000", "example": "g_knockback 99999"},
    {"name": "timescale", "cat": "world", "flags": "HC", "games": "all", "desc": "Game speed (0.5 = slow motion).", "default": "1", "example": "timescale 0.5"},
    {"name": "bg_fallDamageMinHeight", "cat": "world", "flags": "HC", "games": "all", "desc": "Fall height where damage starts.", "default": "128", "example": "bg_fallDamageMinHeight 9998"},
    {"name": "bg_fallDamageMaxHeight", "cat": "world", "flags": "HC", "games": "all", "desc": "Fall height that kills you.", "default": "300", "example": "bg_fallDamageMaxHeight 9999"},
    {"name": "g_gametype", "cat": "match", "flags": "H", "games": "all", "desc": "Game mode for the next map load, e.g. dm, tdm/war, sd.", "example": "g_gametype dm"},
    {"name": "scr_<gametype>_scorelimit", "cat": "match", "flags": "H", "games": "all", "desc": "Score limit for a mode, e.g. scr_dm_scorelimit 0 (no limit).", "example": "scr_dm_scorelimit 0"},
    {"name": "scr_<gametype>_timelimit", "cat": "match", "flags": "H", "games": "all", "desc": "Time limit in minutes for a mode, e.g. scr_dm_timelimit 0.", "example": "scr_dm_timelimit 0"},
    {"name": "map", "cat": "match", "flags": "H", "games": "all", "desc": "Load a map, e.g. 'map mp_nuketown_2020' (BO2).", "example": "map mp_nuketown_2020"},
    {"name": "map_restart", "cat": "match", "flags": "H", "games": "all", "desc": "Restart the current map.", "example": "map_restart"},
    {"name": "fast_restart", "cat": "match", "flags": "H", "games": "all", "desc": "Quick restart of the current match.", "example": "fast_restart"},
    {"name": "party_connectToOthers", "cat": "match", "flags": "", "games": ["mw2", "bo1", "mw3", "bo2"], "desc": "0 = make your own lobby instead of joining others.", "default": "1", "example": "party_connectToOthers 0"},
    {"name": "say", "cat": "misc", "flags": "", "games": "all", "desc": "Send a chat message to everyone.", "example": "say hello"},
    {"name": "say_team", "cat": "misc", "flags": "", "games": "all", "desc": "Send a chat message to your team.", "example": "say_team rush B"},
    {"name": "disconnect", "cat": "misc", "flags": "", "games": "all", "desc": "Leave the current match.", "example": "disconnect"},
    {"name": "reconnect", "cat": "misc", "flags": "", "games": "all", "desc": "Reconnect to the last server.", "example": "reconnect"},
    {"name": "quit", "cat": "misc", "flags": "", "games": "all", "desc": "Quit the game to the dashboard.", "example": "quit"}
  ],
  "presets": {
    "fov": {"desc": "Wider field of view.", "commands": ["cg_fov 90", "cg_fovScale 1.15"]},
    "thirdperson": {"desc": "Third-person camera.", "commands": ["cg_thirdPerson 1", "cg_thirdPersonRange 150"]},
    "firstperson": {"desc": "Back to first person.", "commands": ["cg_thirdPerson 0"]},
    "cinematic": {"desc": "Clean screen for clips: no HUD, no gun.", "commands": ["cg_draw2D 0", "cg_drawGun 0"]},
    "hud": {"desc": "Bring the HUD and gun back.", "commands": ["cg_draw2D 1", "cg_drawGun 1", "cg_drawCrosshair 1"]},
    "noir": {"desc": "Black-and-white look.", "commands": ["r_filmTweakEnable 1", "r_filmUseTweaks 1", "r_filmTweakDesaturation 1"]},
    "colour": {"desc": "Undo 'noir'.", "commands": ["r_filmUseTweaks 0", "r_filmTweakEnable 0"]},
    "moon": {"desc": "Low gravity, huge jumps, no fall damage (host).", "commands": ["sv_cheats 1", "g_gravity 100", "jump_height 999", "bg_fallDamageMinHeight 9998", "bg_fallDamageMaxHeight 9999"]},
    "speed": {"desc": "Fast movement (host).", "commands": ["g_speed 400"]},
    "slowmo": {"desc": "Slow motion (host).", "commands": ["sv_cheats 1", "timescale 0.5"]},
    "sandbox": {"desc": "Practice mode: cheats on, infinite ammo, unlimited sprint (host).", "commands": ["sv_cheats 1", "player_sustainAmmo 1", "player_sprintUnlimited 1"]},
    "reset": {"desc": "Put the view, HUD and world settings back to defaults.", "commands": ["cg_fov 65", "cg_fovScale 1", "cg_thirdPerson 0", "cg_draw2D 1", "cg_drawGun 1", "cg_drawCrosshair 1", "r_filmUseTweaks 0", "r_filmTweakEnable 0", "g_gravity 800", "jump_height 39", "g_speed 190", "timescale 1", "bg_fallDamageMinHeight 128", "bg_fallDamageMaxHeight 300", "player_sustainAmmo 0", "player_sprintUnlimited 0", "sv_cheats 0"]}
  }
}
